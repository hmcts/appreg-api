{
  "request": {
    "method": "GET",
    "urlPath": "/api/rest/named-query/CSDS/DA_GetStandardApplicant/GD",
    "queryParameters": {
      "$f": {
        "matches": "ApplicantID=(\\d+)"
      }
    }
  },
  "response": {
    "status":200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "Applicants/Applicant_{{regexExtract request.url 'ApplicantID(=|%3D)([0-9]+)' 'parts'}}{{parts.1}}_StandardApplicant.json",
    "transformers": [
      "response-template"
    ]
  }
}

