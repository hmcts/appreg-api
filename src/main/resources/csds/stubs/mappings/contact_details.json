{
  "request": {
    "method": "GET",
    "urlPath": "/api/rest/query/CSDS/ContactInformation/GD",
    "queryParameters": {
      "$f": {
        "matches": "FID_StandardApplicant=(\\d+)"
      }
    }
  },
  "response": {
    "status":200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "Applicants/Applicant_{{regexExtract request.url 'FID_StandardApplicant(=|%3D)([0-9]+)' 'parts'}}{{parts.1}}_ContactDetails.json",
    "transformers": [
      "response-template"
    ]
  }
}

